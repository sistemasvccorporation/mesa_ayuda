DJANGO_SECRET_KEY=dev-sigecom-mesa-ayuda-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=proyecto_sigecom
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CELERY_TASK_ALWAYS_EAGER=1
FRONTEND_URL=http://127.0.0.1:5173

# Al enviar un ticket, el correo llega a MESA_AYUDA_NOTIFY_EMAIL y a cada admin con correo en SIGeCom.
# Office 365 / Outlook:
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=tu.usuario@vc-corporation.com
# EMAIL_HOST_PASSWORD=tu-clave
# DEFAULT_FROM_EMAIL=tu.usuario@vc-corporation.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=mesa-ayuda@vc-corporation.com
MESA_AYUDA_NOTIFY_EMAIL=ronaldo.roman@vc-corporation.com
# Primer administrador de mesa: pon aquí un usuarios.usuario activo
MESA_BOOTSTRAP_ADMIN=

# Tunel Cloudflare con nombre (cualquiera entra desde cualquier sitio, sin pedir IP).
# 1) Ejecuta configurar-cloudflare.bat una vez y autoriza el PC.
# 2) El dominio (vc-corporation.com) debe estar en tu cuenta Cloudflare.
CLOUDFLARE_HOSTNAME=mesa-ayuda.vc-corporation.com
CLOUDFLARE_PUBLIC_URL=https://mesa-ayuda.vc-corporation.com
# CLOUDFLARE_TUNNEL_TOKEN=

# cloudflare = tunel rapido trycloudflare.com (activar DNS seguro 1.1.1.1 si el sitio no abre)
TUNEL_MODO=cloudflare
